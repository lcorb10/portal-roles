# Copia este archivo como .env (levantar.sh lo hace solo si no existe) y ajusta los valores.
# El .env NO se sube al repositorio.

# ── Servicios institucionales simulados (dataMock.js) ──────────────────────────────────
# En tu equipo: http://localhost:4000 · Dentro de Podman: el nombre del contenedor.
MOCK_API_URL=http://datamock:4000
ROLES_CLIENT_ID=portal-roles
ROLES_CLIENT_SECRET=secreto-de-prueba
IA_API_KEY=clave-ia-de-prueba
# Segundos de vigencia de los tokens de dataMock (300 por defecto; 20 para probar la renovación)
TOKEN_VIGENCIA_SEGUNDOS=300

# ── Aplicación ─────────────────────────────────────────────────────────────────────────
# Usuarios administradores por configuración, separados por comas.
ADMIN_USERNAMES=admin.prueba
# Cadena larga y aleatoria (mínimo 32 caracteres). levantar.sh genera una si dice "cambiar".
SESSION_SECRET=cambiar
# Pon true si el portal se sirve por HTTPS (la cookie llevará el atributo Secure).
SESION_SOLO_HTTPS=false

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────────
POSTGRES_USER=portal
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=portal
DATABASE_URL=postgresql+asyncpg://portal:cambiar-esta-clave@db:5432/portal
