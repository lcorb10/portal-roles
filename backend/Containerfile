# Backend del Portal de Roles — build en dos etapas con uv.

# ── Etapa 1: dependencias ───────────────────────────────────────────────────────────────
FROM docker.io/library/python:3.12-slim AS dependencias
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# Solo los archivos de dependencias primero: la capa se reutiliza si solo cambia el código.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ── Etapa 2: imagen final, sin uv ni herramientas de build ──────────────────────────────
FROM docker.io/library/python:3.12-slim
RUN useradd --system --uid 10001 --no-create-home portal
WORKDIR /app
COPY --from=dependencias /app/.venv /app/.venv
COPY app ./app
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER portal
EXPOSE 8000
# --proxy-headers: confía en los encabezados X-Forwarded-* que pone nginx.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
